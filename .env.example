# Copie para .env (na raiz do projeto). Sem LLM_PROVIDER a aplicação funciona em modo por regras.
# Nunca versione o arquivo .env.

# none | openai | anthropic
#   openai    = qualquer API compatível com /chat/completions (OpenAI, OpenRouter, Groq, Ollama...)
#   anthropic = API de mensagens da Anthropic
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=
LLM_TIMEOUT=800

# --- Observabilidade (opcional) ---
# Suba a stack: docker compose -f observability/docker-compose.yml up -d
# Depois descomente a linha abaixo e reinicie o backend. Jaeger: http://localhost:16686 | Grafana: http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=jobagent-cv-backend
