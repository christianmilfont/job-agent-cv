  {
   "id": 5,
   "type": "stat",
   "title": "Falhas da IA (fallback)",
   "description": "Chamadas à IA que falharam (timeout, JSON inválido, texto rejeitado); o sistema voltou ao modo por regras.",
   "datasource": {
