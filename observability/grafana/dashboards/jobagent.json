  {
   "id": 7,
   "type": "bargauge",
   "title": "Onde o tempo é gasto (média por etapa)",
   "description": "Média de duração de cada etapa do pipeline no período. Em modo IA, as etapas llm.* dominam.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "clamp_min(sum by (span_name) (jobagent_duration_seconds_sum{span_name=~\"llm.enhance_parse|llm.generate_resume_text|job.parse_rules|job.match|resume.generate_rules|export.pdf|export.docx|db.create_application\"}) - (sum by (span_name) (jobagent_duration_seconds_sum{span_name=~\"llm.enhance_parse|llm.generate_resume_text|job.parse_rules|job.match|resume.generate_rules|export.pdf|export.docx|db.create_application\"} offset $__range) or sum by (span_name) (jobagent_duration_seconds_sum{span_name=~\"llm.enhance_parse|llm.generate_resume_text|job.parse_rules|job.match|resume.generate_rules|export.pdf|export.docx|db.create_application\"}) * 0), 0) / clamp_min(sum by (span_name) (jobagent_duration_seconds_count{span_name=~\"llm.enhance_parse|llm.generate_resume_text|job.parse_rules|job.match|resume.generate_rules|export.pdf|export.docx|db.create_application\"}) - (sum by (span_name) (jobagent_duration_seconds_count{span_name=~\"llm.enhance_parse|llm.generate_resume_text|job.parse_rules|job.match|resume.generate_rules|export.pdf|export.docx|db.create_application\"} offset $__range) or sum by (span_name) (jobagent_duration_seconds_count{span_name=~\"llm.enhance_parse|llm.generate_resume_text|job.parse_rules|job.match|resume.generate_rules|export.pdf|export.docx|db.create_application\"}) * 0), 0)",
     "legendFormat": "{{span_name}}",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "showUnfilled": true
   }
  },
  {
   "id": 8,
   "type": "bargauge",
   "title": "Duração média da chamada à IA por modelo",
   "description": "Compare modelos (ex.: llama3.1 vs llama3.2:3b) mudando LLM_MODEL no .env.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "clamp_min(sum by (llm_model) (jobagent_duration_seconds_sum{span_name=\"llm.request\"}) - (sum by (llm_model) (jobagent_duration_seconds_sum{span_name=\"llm.request\"} offset $__range) or sum by (llm_model) (jobagent_duration_seconds_sum{span_name=\"llm.request\"}) * 0), 0) / clamp_min(sum by (llm_model) (jobagent_duration_seconds_count{span_name=\"llm.request\"}) - (sum by (llm_model) (jobagent_duration_seconds_count{span_name=\"llm.request\"} offset $__range) or sum by (llm_model) (jobagent_duration_seconds_count{span_name=\"llm.request\"}) * 0), 0)",
     "legendFormat": "{{llm_model}}",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
