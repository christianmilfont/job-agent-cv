{
 "uid": "jobagent-cv",
 "title": "Job Agent CV — Geração de currículos",
 "tags": [
  "jobagent"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Gerações de currículo",
   "description": "Requisições POST /api/applications no período.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "clamp_min(sum (jobagent_calls_total{span_name=\"POST /api/applications\"}) - (sum (jobagent_calls_total{span_name=\"POST /api/applications\"} offset $__range) or sum (jobagent_calls_total{span_name=\"POST /api/applications\"}) * 0), 0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "0",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Tempo médio de geração",
   "description": "Tempo total de resposta da geração (análise + currículo + gravação).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "clamp_min(sum (jobagent_duration_seconds_sum{span_name=\"POST /api/applications\"}) - (sum (jobagent_duration_seconds_sum{span_name=\"POST /api/applications\"} offset $__range) or sum (jobagent_duration_seconds_sum{span_name=\"POST /api/applications\"}) * 0), 0) / clamp_min(sum (jobagent_duration_seconds_count{span_name=\"POST /api/applications\"}) - (sum (jobagent_duration_seconds_count{span_name=\"POST /api/applications\"} offset $__range) or sum (jobagent_duration_seconds_count{span_name=\"POST /api/applications\"}) * 0), 0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "noValue": "sem dados",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 120
       },
       {
        "color": "red",
        "value": 300
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "P95 de geração",
   "description": "95% das gerações levam até este tempo (estimado pelos buckets do histograma).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, clamp_min(sum by (le) (jobagent_duration_seconds_bucket{span_name=\"POST /api/applications\"}) - (sum by (le) (jobagent_duration_seconds_bucket{span_name=\"POST /api/applications\"} offset $__range) or sum by (le) (jobagent_duration_seconds_bucket{span_name=\"POST /api/applications\"}) * 0), 0))",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "noValue": "sem dados",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 180
       },
       {
        "color": "red",
        "value": 480
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
